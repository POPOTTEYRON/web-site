# Copier en .env (développement) — ne jamais commiter .env.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL 16
DATABASE_URL=postgres://timango:CHANGER@localhost:5432/timango

# Au moins 32 caractères aléatoires : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Emails : "file" = écrits dans var/mail (aucun envoi réel). "smtp" = production uniquement.
MAIL_TRANSPORT=file
MAIL_FROM="Ti Mango <reservations@timango-gp.example>"
# SMTP_URL=smtp://user:pass@smtp.exemple:587
