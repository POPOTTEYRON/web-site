<% layout('/layouts/base', { title: it.heading, noindex: true }) %>
<div class="wrap wrap--narrow page-head">
  <h1 class="h1"><%= it.heading %></h1>
  <p class="lead"><%= it.text %></p>
  <div class="actions">
    <a class="btn btn--primary" href="<%= it.url('home') %>"><%= it.t('errors.backHome') %></a>
    <a class="btn btn--secondary" href="tel:<%= it.restaurant.telephoneE164 %>"><%= it.restaurant.telephone %></a>
  </div>
</div>
