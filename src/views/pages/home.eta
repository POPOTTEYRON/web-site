<% layout('/layouts/base', { title: it.t('home.title'), head: include('/partials/jsonld', it) }) %>
<section class="hero wrap">
  <div class="hero__text">
    <p class="eyebrow"><%= it.t('home.eyebrow') %></p>
    <h1 class="hero__title"><%= it.t('home.h1') %></h1>
    <p class="hero__lead"><%= it.t('home.lead') %></p>
    <div class="actions">
      <a class="btn btn--primary btn--lg" href="<%= it.url('book') %>"><%= it.t('common.bookTable') %></a>
      <a class="btn btn--secondary btn--lg" href="<%= it.url('menu') %>"><%= it.t('common.seeMenu') %></a>
    </div>
    <%~ include('/partials/status', it) %>
  </div>
  <%~ include('/partials/ph', { ...it, label: it.t('home.heroPhoto'), cls: 'hero__photo' }) %>
</section>

<section class="infobar" aria-label="<%= it.t('home.infoLabel') %>">
  <dl class="wrap infobar__inner">
    <div><dt><%= it.t('common.address') %></dt><dd><a href="<%= it.restaurant.carteOsm %>" rel="noopener"><%= it.restaurant.adresse.rue %>, <%= it.restaurant.adresse.codePostal %> <%= it.restaurant.adresse.ville %></a></dd></div>
    <div><dt><%= it.t('common.hours') %></dt><dd><%= it.t('common.hoursLine') %></dd></div>
    <div><dt><%= it.t('common.phone') %></dt><dd><a href="tel:<%= it.restaurant.telephoneE164 %>"><%= it.restaurant.telephone %></a></dd></div>
  </dl>
</section>

<section class="section wrap" aria-labelledby="h-carte">
  <div class="section__head">
    <h2 id="h-carte" class="h2"><%= it.t('home.menuTitle') %></h2>
    <a class="link-arrow" href="<%= it.url('menu') %>"><%= it.t('common.fullMenu') %></a>
  </div>
  <ul class="dish-list dish-list--two">
    <% for (const dish of it.dishes) { %><%~ include('/partials/dish', { ...it, dish, showAllergens: false }) %><% } %>
  </ul>
  <p class="muted"><%= it.t('common.takeaway') %> <a href="tel:<%= it.restaurant.telephoneE164 %>"><%= it.t('common.takeawayCta') %> <%= it.restaurant.telephone %></a></p>
</section>

<section class="band-light" aria-labelledby="h-resto">
  <div class="wrap split">
    <div class="mosaic">
      <%~ include('/partials/ph', { ...it, label: it.t('restaurant.gallery.1'), cls: 'mosaic__wide' }) %>
      <%~ include('/partials/ph', { ...it, label: it.t('restaurant.gallery.3') }) %>
      <%~ include('/partials/ph', { ...it, label: it.t('restaurant.gallery.4') }) %>
    </div>
    <div class="split__text">
      <h2 id="h-resto" class="h2"><%= it.t('home.restaurantTitle') %></h2>
      <p><%= it.t('home.restaurantText') %></p>
      <p class="todo">[<%= it.t('common.toComplete') %>] <%= it.t('restaurant.storyTodo') %></p>
      <a class="link-arrow" href="<%= it.url('restaurant') %>"><%= it.t('home.restaurantMore') %></a>
    </div>
  </div>
</section>

<section class="band-dark" aria-labelledby="h-book">
  <div class="wrap band-dark__inner">
    <div>
      <h2 id="h-book" class="h2"><%= it.t('home.bookTitle') %></h2>
      <p><%= it.t('home.bookText') %></p>
    </div>
    <a class="btn btn--primary btn--lg" href="<%= it.url('book') %>"><%= it.t('common.bookTable') %></a>
  </div>
</section>

<section class="section wrap split" aria-labelledby="h-acces">
  <div class="split__text">
    <h2 id="h-acces" class="h2"><%= it.t('home.findUs') %></h2>
    <%~ include('/partials/address-hours', it) %>
  </div>
  <%~ include('/partials/map', it) %>
</section>
