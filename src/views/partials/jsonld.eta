<script type="application/ld+json"><%~ JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Restaurant',
  name: it.restaurant.nom, servesCuisine: 'Créole', telephone: it.restaurant.telephoneE164, email: it.restaurant.email,
  address: { '@type': 'PostalAddress', streetAddress: it.restaurant.adresse.rue, postalCode: it.restaurant.adresse.codePostal, addressLocality: it.restaurant.adresse.ville, addressRegion: it.restaurant.adresse.region, addressCountry: it.restaurant.adresse.pays },
  openingHoursSpecification: it.openingHoursSchema,
  hasMenu: it.baseUrl + it.url('menu'),
  acceptsReservations: true,
}).replace(/</g, '\\u003c') %></script>
