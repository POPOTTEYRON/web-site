<address class="address">
  <%= it.restaurant.adresse.rue %><br><%= it.restaurant.adresse.codePostal %> <%= it.restaurant.adresse.ville %>, <%= it.restaurant.adresse.region %><br>
  <a href="tel:<%= it.restaurant.telephoneE164 %>"><%= it.restaurant.telephone %></a><br>
  <a href="mailto:<%= it.restaurant.email %>"><%= it.restaurant.email %></a>
</address>
<table class="hours">
  <caption class="visually-hidden"><%= it.t('common.hours') %></caption>
  <tbody>
    <% for (const row of it.hours.rows) { %>
    <tr><th scope="row"><%= row.label %></th><td><%= row.value || it.t('common.closed') %></td></tr>
    <% } %>
  </tbody>
</table>
<a class="btn btn--secondary" href="<%= it.restaurant.carteOsm %>" rel="noopener"><%= it.t('common.directions') %></a>
