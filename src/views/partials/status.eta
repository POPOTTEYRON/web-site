<% const s = it.status; %>
<p class="status <%= s.open ? 'status--open' : 'status--closed' %>">
  <span class="status__dot" aria-hidden="true"></span>
  <% if (s.closedToday) { %>
    <strong><%= it.t('status.closedToday') %></strong><% if (it.hours.reopens) { %> · <%= it.t('status.reopens', it.hours.reopens) %><% } %>
  <% } else if (s.open) { %>
    <strong><%= it.t('status.openNow') %></strong> · <%= it.fmt.time(s.hours.open) %> – <%= it.fmt.time(s.hours.close) %>
  <% } else if (s.later) { %>
    <strong><%= it.t('status.openToday') %></strong> · <%= it.fmt.time(s.hours.open) %> – <%= it.fmt.time(s.hours.close) %>
  <% } else { %>
    <strong><%= it.t('status.closedNow') %></strong> · <%= it.hours.short %>
  <% } %>
</p>
